      "ko": "기존 양식 수정",
      "ja": "既存の書式を修正"
    }
  ],
  "resolved_statuses": [
    "explicit",
    "reused",
    "source_explicit",
    "delegated"
  ],
  "unresolved_statuses": [
    "unknown",
    "candidate",
    "conflict",
    "assumed"
  ],
  "submission_keys": [
    "schema_version",
    "fields",
    "use",
    "notes",
    "source_paths",
    "conversation_language",
    "delegated_fields",
    "design_preferences",
    "canvas",
    "choice_origins",
    "review_checkpoint"
  ],
  "note": "Schema 1.0 core fields remain compatible. New production also requires resolved use and canvas decisions. Six core answers or PPTX alone cannot select a page ratio. Legacy assumptions remain pending; accepted template observations require current located evidence.",
  "optional_design_preferences": {
    "contract": "../system/design-expression.json",
    "keys": [
      "preset",
      "creativity",
      "visual_intensity"
    ],
    "required": false,
    "note": "Expression remains optional. Use and canvas are separate required layout decisions; schema 1.0 core field map remains compatible."
  },
  "startup_policy": {
    "defaults": {
      "mode": "one_shot",
      "document_type": "report",
      "audience": "Document Studio staff",
      "purpose": "information sharing",
      "final_language": "$conversation_language",
      "output_format": "PPTX"
    },
    "default_use": "reading",
    "reason": "These are suggestions for unanswered questions. Present them as recommendations; never convert omission, a preselected option or a partial reply into an answer.",
    "questions": "Ask only missing required choices in a concise bundle. Preserve pending fields across replies and turns until answered or specifically delegated. Do not repeat already resolved choices. Generic 대충/알아서/그냥 진행/適当に/お任せ does not silently delegate unspecified fields.",
    "default_canvas": "a4-portrait",
    "question_waiting": {
      "reference": "question-waiting.md",
      "scope": "open_interactive_question_control",
      "display_acknowledgment_is_answer": false,
      "final_while_control_awaits_input": false,
      "wait_until": "submitted_reply_or_explicit_cancel_or_actual_host_limitation",
      "per_blocking_wait_max_seconds": 60,
      "minimum_review_wait_seconds": {
        "simple_choice": 60,
        "bundled_or_free_text": 180
      },
      "elapsed_time_resolves_choice": false,
      "fallback": "ordinary_chat_preserve_resolved_and_pending_fields",
      "note": "Instruction guidance, not a host UI timeout setting. Review intervals are not answer deadlines."
    }
  },
  "required_fields": [
    "mode",
    "document_type",
    "audience",
    "purpose",
    "final_language",
    "output_format"
  ],
  "required_layout_fields": [
    "use",
    "canvas"
  ],
  "layout_labels": {
    "use": {
      "ko": "사용처",
      "ja": "用途"
    },
    "canvas": {
      "ko": "판형·방향",
      "ja": "判型・向き"
    }
  },
  "canvas_choices": [
    {
      "value": "a4-portrait",
      "ko": "A4 세로",
      "ja": "A4縦"
    },
    {
      "value": "a4-landscape",
      "ko": "A4 가로",
      "ja": "A4横"
    },
    {
      "value": "widescreen",
      "ko": "16:9 화면",
      "ja": "16:9画面"
    },
    {
      "value": "esg-landscape",
      "ko": "채택한 보고서 가로 양식",
      "ja": "採用済み横長書式"
    }
  ]
