    },
    {
      "value": "live",
      "ko": "화면으로 실제 발표",
      "ja": "画面で発表"
    },
    {
      "value": "office_print",
      "ko": "사무용 프린터 A4 인쇄",
      "ja": "事務用プリンターでA4印刷"
