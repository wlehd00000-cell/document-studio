{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document Studio adaptable layout grammar",
  "type": "object",
  "required": ["schema_version", "rules"],
  "properties": {
    "schema_version": {"const": "layout-grammar/1.0"},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "layer", "document_family", "page_families", "element_roles", "relationships", "constraints", "variation", "evidence_ids", "evidence_refs", "status", "confidence"],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "layer": {"enum": ["brand_dna", "layout_grammar", "creative_vocabulary"]},
          "document_family": {"type": "string", "minLength": 1},
          "page_families": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "element_roles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "relationships": {"type": "array", "items": {"type": "string"}},
          "constraints": {"type": "object"},
          "variation": {"type": "array", "items": {"type": "string"}},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source_id", "page", "region_id"]}},
          "status": {"enum": ["suggested", "accepted", "rejected", "stale"]},
          "confidence": {"enum": ["low", "medium", "high"]}
        }
      }
    }
  }
}
