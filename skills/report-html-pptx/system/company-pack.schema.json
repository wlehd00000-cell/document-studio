{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/document-studio/company-pack.schema.json",
  "title": "Document Studio Company Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_id", "company_name", "version", "status", "default_language", "enabled_languages", "parent_pack"],
  "properties": {
    "schema_version": {"const": "company-pack/1.0"},
    "pack_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "company_name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "reviewed", "approved", "superseded"]},
    "default_language": {"type": "string"},
    "enabled_languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "parent_pack": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}]},
    "synthetic": {"type": "boolean"}
  }
}
