      "protect": [
        "subject identity",
        "title quiet zone",
        "source/concept disclosure",
        "editable title"
      ]
    },
    "chapter_opener": {
      "role": "Change of subject and orientation to following evidence.",
      "density_rule": "Stronger image/type hierarchy; chapter contents only when useful. No invented paragraph to fill whitespace.",
      "image_area_fraction": [
        0.55,
        1.0
      ],
      "title_pt_by_profile": {
        "reading_report": 38,
        "office_print": 24,
        "executive_approval": 30,
        "proposal": 38,
        "execution": 30,
        "reading_deck": 36,
        "live_deck": 42
      },
      "full_bleed_allowed": true,
      "header_footer": "Minimal navigation; omit large sidebar if current document does not need it."
    },
    "editorial": {
      "role": "A subject, scene or story at visual scale with an adjacent explanation rail.",
      "density_rule": "Image-first while claims and conditions remain adjacent and readable.",
      "image_area_fraction": [
        0.5,
        0.85
      ],
      "full_bleed_allowed": true
    },
    "narrative": {
      "role": "Connected explanation and analysis with local supporting evidence.",
      "density_rule": "Purpose profile body typography; 1/2/3 columns chosen for actual language and argument."
    },
    "evidence": {
      "role": "Source image/table/measurement with precise caption and annotation.",
      "density_rule": "Protect source identity, actual detail, period and conditions.",
      "full_bleed_allowed": false
    },
    "comparison": {
      "role": "Comparable alternatives/data on common axes or criteria.",
      "density_rule": "Shared baseline and corresponding rows; no arbitrary large score."
    },
    "process": {
      "role": "Actual flow, authority, owners, branches and handoffs.",
      "density_rule": "Meaningful connectors and editable labels; no decorative arrows."
    },
    "execution": {
      "role": "Dates, owners, dependencies, operating conditions and completion evidence.",
      "density_rule": "Readable shared schedule or owner structure."
    },
    "appendix": {
      "role": "Complete supporting details and reusable reference.",
      "density_rule": "Compact native tables/structured prose, repeat meaningful group headers."
    }
  },
